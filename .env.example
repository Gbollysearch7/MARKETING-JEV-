# Rankcall environment variables. Copy to .env.local for development; in production set them as host
# secrets (fly secrets set ..., or the VPS .env file read by Docker). Never commit real values.
# Only the "Required in production" block is needed to launch; everything else switches features on.

# ---------------------------------------------------------------- Required in production
# Public base URL, no trailing slash. Used for Stripe return URLs, Google OAuth redirects and links in emails.
APP_URL=https://app.example.co.uk
# 32+ random characters (openssl rand -base64 48). Encrypts stored tokens (Google refresh tokens, webhook
# secrets). Changing it makes existing encrypted tokens unreadable, so set it once and keep it in a password manager.
APP_SECRET=
# TypeSafe Jev decision API key. Without it the app runs on the built-in mock answerer (demo quality only).
TYPESAFE_API_KEY=
# Optional Jev overrides: model version and API base URL (leave empty for the defaults).
JEV_MODEL=
JEV_BASE_URL=

# ---------------------------------------------------------------- Runtime
# Where SQLite (app.db) lives. Must be a persistent volume in production. Defaults to ./data.
DATA_DIR=/data
# Port the server listens on (the Docker image defaults to 3000).
PORT=3000
# Set to "production" by the Docker image. Makes the session cookie Secure (HTTPS only).
NODE_ENV=production
# The weekly re-scoring scheduler runs inside the web process. It is on by default in production and off in
# development. "false" turns it off (for example on a second machine, or while restoring a backup); "true" forces it on.
SCHEDULER_ENABLED=
# Optional label shown by /api/health (for example the git sha). Defaults to package.json version.
APP_VERSION=

# ---------------------------------------------------------------- Stripe billing (all five switch card payments on)
# Secret API key: sk_test_... while testing, sk_live_... at launch. Restricted keys need Checkout Sessions and
# Customer Portal write access.
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint https://<APP_URL>/api/billing/webhook (whsec_...).
STRIPE_WEBHOOK_SECRET=
# Recurring GBP monthly price ids for each plan (price_...).
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_SCALE=

# ---------------------------------------------------------------- Google sign-in / Search Console connection
# OAuth 2.0 web client from Google Cloud Console. Authorised redirect URI: <APP_URL>/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------- AI visibility engines (optional, per engine)
# Each key switches one answer engine on in the AI visibility module; *_MODEL overrides its default model.
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=

# ---------------------------------------------------------------- Backups (Litestream, read by scripts/start.sh)
# S3-compatible bucket for continuous SQLite replication. Leave LITESTREAM_BUCKET empty to run without backups.
LITESTREAM_BUCKET=
# Folder inside the bucket.
LITESTREAM_PATH=rankcall/app.db
# AWS S3 London: region eu-west-2, endpoint empty. Cloudflare R2: region auto,
# endpoint https://<account id>.r2.cloudflarestorage.com (choose the EU jurisdiction when creating the bucket).
LITESTREAM_REGION=eu-west-2
LITESTREAM_ENDPOINT=
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------- Development only
# Build into another folder so a second dev server can run beside the main one.
NEXT_DIST_DIR=
