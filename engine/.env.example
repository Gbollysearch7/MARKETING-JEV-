# TypeSafe Jev. Get a key at https://console.typesafe.ai/keys
TYPESAFE_API_KEY=
# Pin the version. Aliases (jev-latest) move when a release ships.
JEV_MODEL=jev-1.13.0
# Optional: route through a gateway that speaks the same contract.
# JEV_BASE_URL=https://api.typesafe.ai
# Set to 1 to run everything offline with the deterministic mock.
JEV_MOCK=0

# Optional: write the decision log to Supabase (PostgREST). Leave blank to write JSONL only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
WORKSPACE_ID=local
