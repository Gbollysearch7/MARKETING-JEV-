/**
 * Builds samples/gate-walks.csv: a fictional programmatic batch for Sample Outdoors (sample-outdoors.example).
 * Town and route names are invented. Mix: well-made location pages, thin near-duplicates, exact copies
 * where the generator dropped the town, one page with placeholder text, a few fixable pages, and a small
 * second template of route guides. Run: npx tsx scripts/make-gate-samples.mts
 */
import { writeFileSync } from 'node:fs';
import Papa from 'papaparse';

const HOST = 'https://www.sample-outdoors.example';
const intro = (t: string) => `<p>Planning a walk near ${t}? Sample Outdoors has put together this guide to walking in and around the area, with routes for every ability. Before you set off, check the weather forecast, wear supportive footwear and carry water, a map and a charged phone.</p>`;
const footer = '<p>Shop walking boots, poles and waterproofs at Sample Outdoors. Free returns on all orders, and our newsletter brings new routes and member offers every month.</p>';
const thinMiddle = (t: string) => `<p>${t} is a great place for walking, with something for everyone whether you're a beginner or an experienced hiker. There are lots of lovely walks to enjoy throughout the year, so pack your bag and head out to explore the countryside.</p>`;
const copyMiddle = '<p>This area is a great place for walking, with something for everyone whether you\'re a beginner or an experienced hiker. There are lots of lovely walks to enjoy throughout the year, so pack your bag and head out to explore the countryside.</p>';

type Good = { town: string; route: string; km: number; ascent: number; start: string; terrain: string; sights: string; cafe: string; transport: string; dogs: string; season: string; second: string };
const GOOD: Good[] = [
  { town: 'Ashcombe Vale', route: 'Ashcombe Beacon loop', km: 9.5, ascent: 310, start: 'the village hall car park on Mill Lane (pay and display, 40 spaces)', terrain: 'Grassy bridleways give way to a stony climb onto the beacon, where the path can be boggy after rain', sights: 'the ruined signal tower and views across the vale to the estuary', cafe: 'The Old Forge tea room by the green opens Wednesday to Sunday', transport: 'Bus 42 from the market town stops outside the hall every two hours', dogs: 'Sheep graze the upper slopes from March to June, so keep dogs on a lead above the cattle grid', season: 'Bluebells fill Hanger Wood in late April', second: 'For a shorter option, the 3 km riverside path to Combe Weir is flat and buggy friendly.' },
  { town: 'Brackenmoor', route: 'Brackenmoor tarn circuit', km: 12, ascent: 450, start: 'the forestry lay-by at Gallows Gate, which fills by 9am at weekends', terrain: 'Open moorland with a peaty path marked by wooden posts; navigation is tricky in mist', sights: 'two upland tarns, a Bronze Age cairn and nesting curlews in spring', cafe: 'there is no café on the route, so carry food; the Moorcock Inn serves lunch back at the road end', transport: 'There is no public transport to the start', dogs: 'Ground-nesting birds mean dogs must be on leads from March to July', season: 'Heather turns the moor purple in August', second: 'A compass bearing from the second tarn back to the posts is worth knowing before you go.' },
  { town: 'Coldwater Ridge', route: 'Ridge and reservoir walk', km: 7.2, ascent: 240, start: 'the reservoir car park off the B-road, free with a small charge for the toilets', terrain: 'A tarmac dam track, then a well-made ridge path with one short scramble at Knuckle Rock', sights: 'the Victorian valve tower and long views over three counties on clear days', cafe: 'The water company kiosk sells hot drinks at weekends', transport: 'The nearest station is four miles away; taxis need booking', dogs: 'Dogs are welcome but swimming in the reservoir is not allowed', season: 'The ridge is exposed and very windy in winter', second: 'Families can turn back at the valve tower for a level 3 km out-and-back.' },
  { town: 'Dunholt', route: 'Dunholt castle and canal walk', km: 6, ascent: 90, start: 'the canal basin, where there is on-street parking on Wharf Road', terrain: 'A level towpath, then field paths with three stiles up to the castle mound', sights: 'the castle earthworks, a flight of five locks and kingfishers along the canal', cafe: 'The Lock Keeper\'s Cottage café sits halfway along the towpath', transport: 'Dunholt station is a five-minute walk from the basin', dogs: 'The stiles have dog gates, though the castle field holds cattle in summer', season: 'The towpath is muddy from November to February', second: 'Step-free walkers can stay on the towpath and skip the castle mound.' },
  { town: 'Elderford', route: 'Elderford stepping stones walk', km: 5.4, ascent: 120, start: 'the free car park behind St Anne\'s church', terrain: 'Woodland paths with tree roots and a crossing of 22 stepping stones', sights: 'the stepping stones, an old packhorse bridge and a wild garlic wood', cafe: 'The Ford Bakery does takeaway pasties and coffee', transport: 'Bus 7 runs hourly from the county town on weekdays', dogs: 'Most dogs manage the stepping stones; there is a footbridge alternative 200 metres upstream', season: 'After heavy rain the stones are underwater, so use the footbridge', second: 'The wild garlic smell in May is a highlight of this route.' },
  { town: 'Fernleigh Cross', route: 'Fernleigh three-villages walk', km: 11, ascent: 200, start: 'the village green, with parking by the pub for customers', terrain: 'Quiet lanes, field edges and a section of old drove road', sights: 'three medieval churches, a working windmill and orchard blossom', cafe: 'Each of the three villages has a pub, and the windmill sells flour and cake on Saturdays', transport: 'The route links two bus stops, so you can walk it one way', dogs: 'Several fields have horses; gates must be closed behind you', season: 'Orchards blossom in late April and early May', second: 'The windmill is open for tours on the first Sunday of each month.' },
  { town: 'Gorsedale', route: 'Gorsedale waterfalls trail', km: 4.8, ascent: 180, start: 'the National Trust car park, free for members', terrain: 'A stepped gorge path that is slippery when wet, with handrails at the steepest parts', sights: 'four waterfalls, the largest dropping about 15 metres into a plunge pool', cafe: 'A seasonal kiosk at the car park opens Easter to October', transport: 'A summer shuttle bus runs from the town at weekends', dogs: 'Dogs on leads; the steps are hard for older dogs', season: 'The falls are most impressive after a wet spell in autumn', second: 'Wear boots with good grip: the gorge rocks stay damp all year.' },
  { town: 'Hollinsby', route: 'Hollinsby coast and dunes walk', km: 8.3, ascent: 60, start: 'the beach car park at the end of Shore Road (charges April to September)', terrain: 'Firm sand at low tide, then a boardwalk through the dunes', sights: 'a seal colony on the sandbar, a wartime pillbox and natterjack toad ponds', cafe: 'The Dune Hut serves fish and chips in summer', transport: 'The coast bus stops at the top of Shore Road', dogs: 'Dogs are banned from the main beach from May to September; use the dune path instead', season: 'Check the tide times: the sandbar section is cut off two hours either side of high tide', second: 'Keep at least 50 metres from the seals, especially in the pupping season.' },
  { town: 'Ivydown', route: 'Ivydown hill fort walk', km: 6.7, ascent: 210, start: 'the lay-by on the downs road, room for about ten cars', terrain: 'Chalk grassland on a steady climb, with flint paths that are slippery in frost', sights: 'the double ramparts of the hill fort, chalkhill blue butterflies and a dew pond', cafe: 'The farm shop at the foot of the down has a small café', transport: 'There is no bus; the nearest station is 6 km away', dogs: 'Cattle graze inside the ramparts from May to October', season: 'Wild orchids flower on the ramparts in June', second: 'An information board at the dew pond explains how the ramparts were built.' },
  { town: 'Kestrel Bay', route: 'Kestrel Bay clifftop walk', km: 10, ascent: 380, start: 'the harbour car park, which also has toilets and a slipway', terrain: 'A switchback coast path with several steep valleys and unfenced cliff edges', sights: 'nesting seabirds, an old lifeboat station and a sea arch at Gull Point', cafe: 'The Harbour Light café opens all year', transport: 'Buses link both ends of the walk in summer', dogs: 'Keep dogs on leads near the unfenced edges', season: 'Puffins nest on the stacks from May to July', second: 'Walk it westbound in the afternoon for the sun behind you.' },
  { town: 'Larkhollow', route: 'Larkhollow beech woods walk', km: 5, ascent: 100, start: 'the woodland car park on Holloway Lane (free)', terrain: 'Broad woodland rides, with a sunken lane that floods in winter', sights: 'ancient beech pollards, a chalk stream and red kites overhead', cafe: 'The Larkhollow Arms has a garden and serves food all day', transport: 'Bus 19 stops in the village on weekdays', dogs: 'A good dog walk with streams to drink from', season: 'Autumn colour peaks in late October', second: 'The sunken lane has a raised path on its west side when it floods.' },
  { town: 'Millbeck', route: 'Millbeck valley and mill walk', km: 7.6, ascent: 160, start: 'the mill museum car park (free if you visit the museum)', terrain: 'A riverside path with a few rocky steps and two footbridges', sights: 'a restored water mill, otter signs on the riverbank and a packhorse trail', cafe: 'The museum café serves bread baked with flour from the mill', transport: 'Millbeck has an hourly bus to the city on weekdays', dogs: 'Dogs welcome on leads; the museum allows them in the yard only', season: 'The river path can close after floods; check the museum page', second: 'The mill grinds on Sunday afternoons, which is worth timing your walk around.' },
];

const IMPROVE = [
  { town: 'Northfen', mid: '<p>The Northfen dyke walk is a flat 6 km loop from the pumping station along raised banks, with marsh harriers over the reed beds.</p><p>Start from the small car park by the pumping station gates. The banks are exposed, so bring a windproof layer, and expect the grass path to be wet underfoot from autumn to spring. Barn owls hunt along the dykes at dusk.</p>' },
  { town: 'Oakhurst Green', mid: '<p>Our guided Oakhurst Green walk is guaranteed to be completely safe for all ages, and with our route card you will never get lost. It is the safest walk in the region.</p><p>The loop is 5 km from the green, past the duck pond and the old oak.</p><p>Parking is on the lane beside the church. The path crosses two meadows and a short boardwalk before returning along the brook to the green.</p>' },
  { town: 'Pendlewick', mid: '<p>93% of visitors say Pendlewick has the best walking in the county, and studies show walkers here are happier. The moor road loop is 8 km with a climb to the trig point.</p><p>Park in the village and follow the old packhorse track uphill. The top section is open moorland with good views north, and the descent follows a quiet lane back past the chapel.</p>' },
  { town: 'Quarrymoor', mid: '<p>The old quarry trail is 4 km and follows the tramway past spoil heaps and a flooded pit; keep to the fenced path.</p><p>Parking is on Quarry Road.</p><p>Look for the winding house ruins near the top of the incline. Gloves help on the rusty gate latches and the spoil is loose, so stay on the path.</p>' },
  { town: 'Ravensholt', mid: '<p>Ravensholt woods have a waymarked 3 km family trail with a wooden play area, plus a longer 7 km route over Raven Crag for confident walkers.</p><p>Both routes start from the forestry car park, which charges by the hour. The crag route has a rocky section near the top that needs care in the wet.</p>' },
  { town: 'Saltmere', mid: '<p>The Saltmere lagoon path is 5 km, flat and suitable for wheelchairs as far as the bird hide, where avocets feed in spring.</p><p>Park at the visitor centre, which has toilets and a small shop. Beyond the hide the path becomes a grass bank that floods on very high tides.</p>' },
  { town: 'Thornby Fell', mid: '<p>Thornby Fell rises above the village, and a 9 km circuit climbs past the old lead mines to the summit cairn. The path is steep and rough near the top.</p><p>Allow four hours. Park by the village institute and take the miners\' track behind the chapel; the spoil heaps are fenced and should not be climbed.</p>' },
  { town: 'Underwood Cross', mid: '<p>Underwood Cross sits between two rivers; a 6 km loop follows both banks and crosses at the old ford by stepping stones.</p><p>When the rivers are high, use the footbridge by the mill instead of the stepping stones. There is roadside parking by the war memorial.</p>' },
];

const THIN = ['Valewick', 'Willowmere', 'Yarrowby', 'Ambleford', 'Birchcombe', 'Cragside End', 'Dovecote Hill', 'Eskholme', 'Foxley Down', 'Greywater', 'Heronsgate Moor', 'Inglewick'];
const COPIES = ['Kettlemere', 'Lindenholt', 'Moorcroft'];

const ROUTES = [
  { slug: 'three-peaks-of-the-vale', title: 'The three peaks of the vale: a 24 km challenge route', query: 'three peaks challenge walk', body: '<h2>Overview</h2><p>This long-distance challenge links Ashcombe Beacon, Thornby Fell and Ivydown in a single day. Allow nine to eleven hours and start before 7am in summer.</p><h2>Planning</h2><p>There are two resupply points: the Moorcock Inn at 9 km and the farm shop below Ivydown at 17 km. Water is not available on the tops. Leave a route plan with someone at home and carry a head torch even in June, because the final descent through Hanger Wood is dark early.</p><h2>Kit</h2><p>Lightweight boots or trail shoes with grip, a waterproof jacket with taped seams, poles for the descents and at least two litres of water. The moorland section needs a map and compass; phone signal drops out between the first and second peak.</p><h2>Getting back</h2><p>The route ends at Ivydown, six kilometres from the start; book a taxi in advance or leave a second car at the farm shop.</p>' },
  { slug: 'family-walks-under-5km', title: 'Family walks under 5 km near the vale', query: 'easy family walks', body: '<h2>How we chose these walks</h2><p>Every walk here is under 5 km, has toilets at the start, and avoids roads and cliff edges. We noted where buggies can go and where they cannot.</p><h2>The walks</h2><p>Combe Weir riverside path (3 km, buggy friendly, ducks and a playground at the end). Larkhollow family trail (3 km, a wooden play area and a stream for paddling). Saltmere lagoon to the bird hide (2.5 km each way, flat boardwalk). Gorsedale lower falls (1.5 km, steps, not for buggies).</p><h2>Tips</h2><p>Bring a spare layer for each child, plenty of snacks and a small first aid kit. Start with the shortest walk and let children set the pace; most families find 3 km takes about an hour and a half with stops.</p>' },
  { slug: 'winter-walking-safety', title: 'Winter walking on the moors: what changes', query: 'winter walking tips', body: '<h2>Shorter days</h2><p>In December there are fewer than eight hours of usable light. Plan to be off the tops by 3pm and carry a head torch with spare batteries.</p><h2>Ground conditions</h2><p>Peat paths freeze hard and then turn to deep mud in a thaw. Flagstones and boardwalks become slippery with frost; microspikes help on icy sections but are not a substitute for crampons on steep snow.</p><h2>Layers</h2><p>Wind on the ridges makes it feel much colder than the valley forecast. Pack a warm hat, gloves, a spare insulated layer and a flask. Mountain weather forecasts give wind speeds on the summits; check them, not just the town forecast.</p><h2>Navigation</h2><p>Snow hides paths and posts, so practise with a map and compass on a clear day before relying on it in poor visibility.</p>' },
  { slug: 'dog-friendly-routes', title: 'Dog-friendly routes around the vale', query: 'dog friendly walks', body: '<h2>What makes a route dog friendly</h2><p>We looked for routes with water to drink, few stiles, little livestock and pubs or cafés that welcome dogs.</p><h2>Our picks</h2><p>Larkhollow beech woods: shade and streams all the way. Dunholt canal towpath: flat, with dog gates on the stiles. Coldwater Ridge: open views, but no swimming in the reservoir.</p><h2>Seasonal rules</h2><p>Brackenmoor and Ivydown have ground-nesting birds or grazing cattle in spring and summer, so leads are required. Hollinsby beach bans dogs from May to September; the dune path is the alternative.</p><h2>Ticks</h2><p>Bracken and long grass carry ticks from spring to autumn. Check your dog and yourself after each walk and remove ticks with a tick hook.</p>' },
];

const rows: Record<string, string>[] = [];
const slug = (t: string) => t.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const add = (t: string, title: string, h1: string, meta: string, body: string, query: string) =>
  rows.push({ url: `${HOST}/walks/${slug(t)}`, title, h1, 'meta description': meta, body, 'target query': query, template: 'walks-location' });

for (const g of GOOD) {
  const body = `${intro(g.town)}<h2>The ${g.route}</h2><p>The ${g.route} is a ${g.km} km circular walk with ${g.ascent} metres of ascent, starting from ${g.start}. ${g.terrain}. Highlights include ${g.sights}.</p><h2>Food, transport and dogs</h2><p>${g.cafe}. ${g.transport}. ${g.dogs}.</p><h2>When to go</h2><p>${g.season}. ${g.second}</p>${footer}`;
  add(g.town, `Walks in ${g.town}: the ${g.route} and more | Sample Outdoors`, `Walks in ${g.town}`, `The ${g.route}: ${g.km} km, ${g.ascent} m of ascent, with parking, cafés and dog advice.`, body, `walks in ${g.town.toLowerCase()}`);
}
IMPROVE.forEach((g, i) => {
  // One page reuses another page's title, a common generator slip.
  const title = i === 3 ? `Walks in ${IMPROVE[2].town} | Sample Outdoors` : `Walks in ${g.town} | Sample Outdoors`;
  add(g.town, title, `Walks in ${g.town}`, `Walking routes near ${g.town}.`, `${intro(g.town)}${g.mid}${footer}`, `walks in ${g.town.toLowerCase()}`);
});
for (const t of THIN) add(t, `Walks in ${t} | Sample Outdoors`, `Walks in ${t}`, `Discover the best walks in ${t}.`, `${intro(t)}${thinMiddle(t)}${footer}`, `walks in ${t.toLowerCase()}`);
for (const t of COPIES) add(t, `Walks in ${t} | Sample Outdoors`, `Walks in ${t}`, `Discover the best walks in ${t}.`, `${intro('this area')}${copyMiddle}${footer}`, `walks in ${t.toLowerCase()}`);
add('Ormsby Ford', 'Walks in Ormsby Ford | Sample Outdoors', '', 'Discover the best walks in {{town}}.', `${intro('Ormsby Ford')}<p>[INSERT LOCAL HIGHLIGHTS] The main loop is {{distance}} km and starts from {{start_point}}.</p>${footer}`, 'walks in ormsby ford');
for (const r of ROUTES) rows.push({ url: `${HOST}/routes/${r.slug}`, title: `${r.title} | Sample Outdoors`, h1: r.title, 'meta description': r.title, body: r.body, 'target query': r.query, template: 'routes-guide' });

writeFileSync('samples/gate-walks.csv', Papa.unparse(rows, { columns: ['url', 'title', 'h1', 'meta description', 'body', 'target query', 'template'] }));
console.log(`Wrote samples/gate-walks.csv with ${rows.length} pages`);
